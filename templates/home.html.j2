<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }}</title>
<meta name="description" content="{{ site_title }}, {{ season }} season. Matchup recaps, keeper declarations, draft history, and the mountain of shame.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header class="masthead">
  <div class="masthead__inner">
    <p class="masthead__eyebrow">Official rulings &middot; {{ season }} season</p>
    <h1 class="masthead__title">{{ site_title }}</h1>
    <p class="masthead__headline">Welcome Deerfoot Footballers</p>
  </div>
</header>

<div class="stripe" role="presentation"></div>

<main class="page">

  <section class="peaks" aria-labelledby="peaks-heading">
    <h2 class="section-title" id="peaks-heading">The standing</h2>

    <div class="summits">
      <div>
        <p class="summit-label" id="summit-champions-label">Champions Summit</p>
        <div class="summit summit--champions" aria-labelledby="summit-champions-label">
          <svg class="summit__art" viewBox="0 0 400 520" preserveAspectRatio="none" aria-hidden="true">
            <polygon points="10,520 150,230 200,40 250,230 390,520"
                      fill="var(--turf)" stroke="var(--turf-deep)" stroke-width="3"></polygon>
            <polygon points="170,130 200,40 230,130 200,165"
                      fill="#EAF2ED" stroke="var(--turf-deep)" stroke-width="2"></polygon>
          </svg>
          <div class="summit__body">
            <div class="summit__climb">
              {% for team in champions %}
              <div class="summit__team">
                <strong>{{ team.name }}</strong>
                <span class="summit__years">{{ team.years|join(', ') }}</span>
              </div>
              {% else %}
              <p class="summit__empty">Nobody's reached the top yet.</p>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <div>
        <p class="summit-label" id="summit-peak-label">Beak Peak</p>
        <div class="summit summit--peak" aria-labelledby="summit-peak-label">
          <svg class="summit__art" viewBox="0 0 400 280" preserveAspectRatio="none" aria-hidden="true">
            <polygon points="10,280 200,70 390,280"
                      fill="var(--turf)" stroke="var(--turf-deep)" stroke-width="3"></polygon>
          </svg>
          <div class="summit__body">
            <div class="summit__climb">
              {% for team in non_champions %}
              <div class="summit__team summit__team--plain">{{ team }}</div>
              {% else %}
              <p class="summit__empty">Everyone's won something. Suspicious.</p>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="foot__fine" style="margin-top: 1rem; color: var(--whistle);">
      Championships are matched to teams by their current name, so a team that's
      since renamed may be missing from its actual summit.
    </p>
  </section>

  <div class="stripe stripe--inline" role="presentation"></div>

  <nav class="archive" aria-label="Site">
    <h2 class="section-title">Around the league</h2>
    <ul class="archive__list">
      <li><a class="archive__link" href="recap.html">Latest recap</a></li>
      <li><a class="archive__link" href="keepers.html">Keeper declarations</a></li>
      <li><a class="archive__link" href="draft-history.html">Draft history</a></li>
    </ul>
  </nav>

</main>

<footer class="foot">
  <p>Updated {{ updated }}.</p>
</footer>

</body>
</html>
