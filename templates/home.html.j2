<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }}</title>
<meta name="description" content="{{ site_title }}, {{ season }} season. Matchup recaps, keeper declarations, draft history, and the mountain of shame.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header class="masthead">
  <div class="masthead__inner">
    <p class="masthead__eyebrow">Official rulings &middot; {{ season }} season</p>
    <p class="masthead__headline">Welcome Deerfoot Footballers</p>
  </div>
</header>

<div class="stripe" role="presentation"></div>

<main class="page">

  <nav class="archive" aria-label="Site">
    <h2 class="section-title">Around the league</h2>
    <ul class="archive__list">
      <li><a class="archive__link" href="recap.html">Latest recap</a></li>
      <li><a class="archive__link" href="keepers.html">Keeper declarations</a></li>
      <li><a class="archive__link" href="draft-history.html">Draft history</a></li>
    </ul>
  </nav>

  <div class="stripe stripe--inline" role="presentation"></div>

  <section class="peaks" aria-labelledby="peaks-heading">
    <h2 class="section-title" id="peaks-heading">The standing</h2>

    <div class="ridge">
      <img class="ridge__art" src="img/mountains.png" alt="" aria-hidden="true">

      <p class="ridge__label" style="left: 39%;" id="champions-summit-label">Champions Summit</p>
      <div class="ridge__cluster" style="left: 39%;" aria-labelledby="champions-summit-label">
        {% for team in champions %}
        <div class="badge badge--champion" title="{{ team.name }} ({{ team.years|join(', ') }})">
          {% if team.logo_url %}
          <img src="{{ team.logo_url }}" alt="{{ team.name }}" loading="lazy"
               onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'badge__initial',textContent:'{{ team.name[0] }}'}))">
          {% else %}
          <span class="badge__initial">{{ team.name[0] }}</span>
          {% endif %}
        </div>
        {% else %}
        <p class="ridge__empty">Nobody's reached the top yet.</p>
        {% endfor %}
      </div>

      <p class="ridge__label" style="left: 62%;" id="beak-peak-label">Beak Peak</p>
      <div class="ridge__cluster" style="left: 62%;" aria-labelledby="beak-peak-label">
        {% for team in non_champions %}
        <div class="badge" title="{{ team.name }}">
          {% if team.logo_url %}
          <img src="{{ team.logo_url }}" alt="{{ team.name }}" loading="lazy"
               onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'badge__initial',textContent:'{{ team.name[0] }}'}))">
          {% else %}
          <span class="badge__initial">{{ team.name[0] }}</span>
          {% endif %}
        </div>
        {% else %}
        <p class="ridge__empty">Everyone's won something. Suspicious.</p>
        {% endfor %}
      </div>
    </div>

    <p class="foot__fine" style="margin-top: 1rem; color: var(--whistle);">
      Championships are matched to teams by their current name, so a team that's
      since renamed may be missing from its actual summit.
    </p>
  </section>

</main>

<footer class="foot">
  <p>Updated {{ updated }}.</p>
</footer>

</body>
</html>
