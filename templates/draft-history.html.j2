<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }} — Draft history</title>
<meta name="description" content="Draft history for {{ site_title }}, searchable by player and by year.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header class="masthead">
  <div class="masthead__inner">
    <p class="masthead__eyebrow">Official rulings &middot; {{ season }} season</p>
    <h1 class="masthead__title">{{ site_title }}</h1>
    <p class="masthead__week">Draft history</p>
  </div>
</header>

<div class="stripe" role="presentation"></div>

<main class="page">

  <section class="draft" aria-labelledby="draft-heading">
    <h2 class="section-title" id="draft-heading">Every pick, every year</h2>

    {% if years %}
    <div class="draft-toolbar">
      <input type="search" id="draft-search" class="draft-search"
             placeholder="Search a player..." aria-label="Search by player name">
      <div class="draft-pills" id="draft-year-pills" role="group" aria-label="Filter by year">
        <button type="button" class="draft-pill draft-pill--active" data-year="all">All years</button>
        {% for y in years %}
        <button type="button" class="draft-pill" data-year="{{ y }}">{{ y }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="draftboard" id="draft-board" role="table" aria-label="Draft picks">
      <div class="draftrow draftrow--head" role="row">
        <span role="columnheader">Yr</span>
        <span role="columnheader">Rd.Pick</span>
        <span role="columnheader">Team</span>
        <span role="columnheader">Player</span>
      </div>
      <div id="draft-rows"></div>
    </div>
    <p class="power__note" id="draft-empty" style="display:none;">No picks match that search.</p>

    <script type="application/json" id="draft-data">{{ years_json|safe }}</script>
    <script>
    (function () {
      var data = JSON.parse(document.getElementById('draft-data').textContent);
      var rowsEl = document.getElementById('draft-rows');
      var emptyEl = document.getElementById('draft-empty');
      var searchEl = document.getElementById('draft-search');
      var pillsEl = document.getElementById('draft-year-pills');
      var activeYear = 'all';

      var allYears = Object.keys(data).sort().reverse();

      function flatten() {
        var out = [];
        allYears.forEach(function (year) {
          (data[year] || []).forEach(function (pick) {
            out.push(Object.assign({ year: year }, pick));
          });
        });
        return out;
      }
      var all = flatten();

      function render() {
        var q = searchEl.value.trim().toLowerCase();
        var rows = all.filter(function (p) {
          if (activeYear !== 'all' && p.year !== activeYear) return false;
          if (q && (!p.player || p.player.toLowerCase().indexOf(q) === -1)) return false;
          return true;
        });

        rowsEl.innerHTML = rows.map(function (p) {
          var keeper = p.keeper ? ' <span class="draft-keeper">K</span>' : '';
          return '<div class="draftrow" role="row">' +
            '<span role="cell">' + p.year + '</span>' +
            '<span role="cell">' + p.round + '.' + p.pick + '</span>' +
            '<span role="cell">' + (p.team || '') + '</span>' +
            '<span role="cell">' + (p.player || 'Unknown') + keeper + '</span>' +
            '</div>';
        }).join('');

        emptyEl.style.display = rows.length ? 'none' : 'block';
      }

      searchEl.addEventListener('input', render);
      pillsEl.addEventListener('click', function (e) {
        var btn = e.target.closest('.draft-pill');
        if (!btn) return;
        pillsEl.querySelectorAll('.draft-pill').forEach(function (b) {
          b.classList.remove('draft-pill--active');
        });
        btn.classList.add('draft-pill--active');
        activeYear = btn.dataset.year;
        render();
      });

      render();
    })();
    </script>
    {% else %}
    <p class="power__note">No draft history fetched yet.</p>
    {% endif %}
  </section>

  <nav class="archive" aria-label="Site">
    <h2 class="section-title">Elsewhere</h2>
    <ul class="archive__list">
      <li><a class="archive__link" href="index.html">Latest recap</a></li>
      <li><a class="archive__link" href="keepers.html">Keeper declarations</a></li>
    </ul>
  </nav>

</main>

<footer class="foot">
  <p>Updated {{ updated }}.</p>
  <p class="foot__fine">Search and year filters run in your browser against the picks
  embedded in this page — nothing is fetched after it loads.</p>
</footer>

</body>
</html>
