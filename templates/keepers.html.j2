<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }} — Keeper declarations</title>
<meta name="description" content="Keeper declarations for {{ site_title }}, {{ season }} season.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header class="masthead">
  <div class="masthead__inner">
    <p class="masthead__eyebrow">Official rulings &middot; {{ season }} season</p>
    <h1 class="masthead__title">{{ site_title }}</h1>
    <p class="masthead__week">Keeper declarations</p>
  </div>
</header>

<div class="stripe" role="presentation"></div>

<main class="page">

  {% if calc_year %}
  <section class="calculator" aria-labelledby="calc-heading">
    <h2 class="section-title" id="calc-heading">Keeper cost calculator</h2>
    <p class="power__note">
      Type a player's name to see what round they cost in the {{ calc_year }} draft,
      and whether they were a keeper that year.
    </p>

    <form id="calc-form" class="draft-toolbar" onsubmit="return false;">
      <input type="text" id="calc-search" class="draft-search" list="calc-players"
             placeholder="Search a player..." aria-label="Search a player">
      <datalist id="calc-players"></datalist>
      <button type="submit" class="draft-pill draft-pill--active">Check</button>
    </form>

    <div id="calc-result"></div>

    <script type="application/json" id="calc-data">{{ calc_data_json|safe }}</script>
    <script>
    (function () {
      var data = JSON.parse(document.getElementById('calc-data').textContent);
      var form = document.getElementById('calc-form');
      var input = document.getElementById('calc-search');
      var datalist = document.getElementById('calc-players');
      var resultEl = document.getElementById('calc-result');

      Object.keys(data).sort().forEach(function (key) {
        var opt = document.createElement('option');
        opt.value = data[key].player;
        datalist.appendChild(opt);
      });

      function render(name) {
        var rec = data[name.trim().toLowerCase()];
        if (!rec) {
          resultEl.innerHTML = '<article class="game"><p class="score__team" ' +
            'style="margin-bottom: 0.5rem;">' + name + '</p>' +
            '<p class="power__note" style="margin:0;">Undrafted</p></article>';
          return;
        }
        var pickText = 'Round ' + rec.round + (rec.pick ? ', Pick ' + rec.pick : '');
        var keeperText = rec.keeper
          ? '<span class="draft-keeper">K</span> Was a keeper'
          : 'Not a keeper';
        resultEl.innerHTML = '<article class="game"><p class="score__team" ' +
          'style="margin-bottom: 0.5rem;">' + rec.player + '</p>' +
          '<p style="margin:0;">' + pickText + '</p>' +
          '<p style="margin: 0.4rem 0 0;">' + keeperText + '</p></article>';
      }

      form.addEventListener('submit', function () {
        if (input.value.trim()) render(input.value);
      });
    })();
    </script>
  </section>

  <div class="stripe stripe--inline" role="presentation"></div>
  {% endif %}

  <section class="keepers" aria-labelledby="keepers-heading">
    <h2 class="section-title" id="keepers-heading">Who's protected</h2>
    <p class="power__note">
      ESPN doesn't expose keeper declarations through its public API, so this
      list is kept by hand and updated as managers lock in their picks.
      {% if keepers_updated %}Last updated {{ keepers_updated }}.{% endif %}
    </p>

    <div class="keepers-grid">
      {% for team, picks in keepers.items() %}
      <article class="game">
        <p class="score__team" style="margin-bottom: 0.85rem;">{{ team }}</p>
        {% if picks %}
        <ul class="penalties">
          {% for p in picks %}
          <li class="penalty" style="grid-template-columns: 1fr auto;">
            <span class="penalty__text">
              <strong>{{ p.player }}</strong>
              {% if p.pro_team or p.position %} &middot; {{ p.pro_team }} {{ p.position }}{% endif %}
            </span>
            <span class="penalty__cost" style="color: var(--whistle);">
              {% if p.round %}Rd {{ p.round }}{% if p.pick %}, Pick {{ p.pick }}{% endif %}{% endif %}
            </span>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="power__note" style="margin: 0;">No keepers declared yet.</p>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </section>

  <nav class="archive" aria-label="Site">
    <h2 class="section-title">Elsewhere</h2>
    <ul class="archive__list">
      <li><a class="archive__link" href="index.html">Home</a></li>
      <li><a class="archive__link" href="recap.html">Latest recap</a></li>
      <li><a class="archive__link" href="draft-history.html">Draft history</a></li>
    </ul>
  </nav>

</main>

<footer class="foot">
  <p>Updated {{ updated }}.</p>
  <p class="foot__fine">Keeper declarations are self-reported by the commissioner from ESPN's
  keepers page and may lag the source by a few days.</p>
</footer>

</body>
</html>
