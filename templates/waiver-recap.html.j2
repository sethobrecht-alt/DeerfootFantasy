<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }} — Waiver Recap</title>
<meta name="description" content="Every waiver move that processed this week for {{ site_title }}, with the overpays and hot pickups called out.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header class="masthead">
  <div class="masthead__inner">
    <p class="masthead__eyebrow">Official rulings &middot; {{ season }} season</p>
    <h1 class="masthead__title">{{ site_title }}</h1>
    <p class="masthead__week">Waiver Recap &middot; Week {{ data.week }}</p>
  </div>
</header>

<div class="stripe" role="presentation"></div>

<main class="page">

  <nav class="archive" aria-label="Site">
    <h2 class="section-title">Around the league</h2>
    <ul class="archive__list">
      <li><a class="archive__link" href="index.html">Home</a></li>
      <li><a class="archive__link" href="recap.html">Weekly Recap</a></li>
      <li><a class="archive__link" href="waiver-recap.html">Waiver Recap</a></li>
      <li><a class="archive__link" href="keepers.html">Keepers</a></li>
      <li><a class="archive__link" href="draft-history.html">Draft history</a></li>
      <li><a class="archive__link" href="standings-history.html">Standings history</a></li>
      <li><a class="archive__link" href="league-basics.html">League basics</a></li>
      <li><a class="archive__link" href="power-rankings.html">Power rankings</a></li>
    </ul>
  </nav>

  <div class="stripe stripe--inline" role="presentation"></div>

  {% if not data.moves and not data.fa_moves %}
  <section class="games">
    <p class="power__note">No waiver moves processed this week.</p>
  </section>
  {% else %}

  {% if data.chipwich or data.camp_chair or data.bag_of_chips or data.fudjo %}
  <section class="trophies" aria-label="This week's waiver awards">
    {% if data.chipwich %}
    <div class="peak peak--gold">
      <div class="peak__body">
        <p class="peak__call">The Chipwich</p>
        <p class="peak__subtitle">The Real Prize</p>
        <p class="peak__team">{{ data.chipwich.player }}</p>
        <p class="peak__line">
          <span class="peak__number">{{ data.chipwich.bidder_count }}</span>
          <span class="peak__unit">teams bid &middot; won by {{ data.chipwich.team }} (${{ data.chipwich.bid }})</span>
        </p>
      </div>
    </div>
    {% endif %}
    {% if data.camp_chair %}
    <div class="peak peak--valley">
      <div class="peak__body">
        <p class="peak__call">The Camp Chair</p>
        <p class="peak__subtitle">Biggest Overpay</p>
        <p class="peak__team">{{ data.camp_chair.player }}</p>
        <p class="peak__line">
          <span class="peak__number">${{ data.camp_chair.overpay }}</span>
          <span class="peak__unit">over the next best offer &middot; {{ data.camp_chair.team }} paid ${{ data.camp_chair.bid }}</span>
        </p>
      </div>
    </div>
    {% endif %}
    {% if data.bag_of_chips %}
    <div class="peak peak--mediocre">
      <div class="peak__body">
        <p class="peak__call">The Bag of Chips</p>
        <p class="peak__subtitle">Who even cares</p>
        <p class="peak__team">{{ data.bag_of_chips.player }}</p>
        <p class="peak__line">
          <span class="peak__number">${{ data.bag_of_chips.bid }}</span>
          <span class="peak__unit">{{ data.bag_of_chips.team }}, nobody else wanted him</span>
        </p>
      </div>
    </div>
    {% endif %}
    {% if data.fudjo %}
    <div class="peak peak--fudjo">
      <div class="peak__body">
        <p class="peak__call">Dropped His Fudjo in the Dirt</p>
        <p class="peak__subtitle">Wasted money and dreams</p>
        <p class="peak__team">{{ data.fudjo.player }}</p>
        <p class="peak__line">
          <span class="peak__number">+${{ data.fudjo.overpay }}</span>
          <span class="peak__unit">{{ data.fudjo.team }} paid ${{ data.fudjo.bid }} for it</span>
        </p>
      </div>
    </div>
    {% endif %}
  </section>

  <div class="stripe stripe--inline" role="presentation"></div>
  {% endif %}

  {% set blown = data.moves | selectattr("blew_the_account") | list %}
  {% if blown %}
  <section class="flagwrap" aria-label="Manager callouts">
    <ul class="penalties">
      {% for m in blown %}
      <li class="penalty">
        <span class="penalty__mark" aria-hidden="true"></span>
        <span class="penalty__text">
          <strong>{{ m.team }}</strong> blew the whole camp store account on {{ m.player }}.
        </span>
        <span class="penalty__cost">${{ m.bid }}</span>
      </li>
      {% endfor %}
    </ul>
  </section>

  <div class="stripe stripe--inline" role="presentation"></div>
  {% endif %}

  <section class="draft" aria-labelledby="waivers-heading">
    <h2 class="section-title" id="waivers-heading">Every waiver claim (FAAB budget: ${{ data.budget }})</h2>

    {% if data.moves %}
    <div class="waiverboard">
      <div class="waiverrow waiverrow--head" role="row">
        <span>Team</span>
        <span>Added</span>
        <span>Dropped</span>
        <span>Bid</span>
        <span>Bidders</span>
        <span>Overpay</span>
      </div>
      {% for m in data.moves %}
      <div class="waiverrow" role="row">
        <span>{{ m.team }}</span>
        <span>{{ m.player }}</span>
        <span>{{ m.dropped or '—' }}</span>
        <span>${{ m.bid }}</span>
        <span>{{ m.bidder_count }}</span>
        <span>{{ ('$' ~ m.overpay) if m.overpay else '—' }}</span>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="power__note">No paid waiver claims processed this week.</p>
    {% endif %}
  </section>

  {% if data.fa_moves %}
  <div class="stripe stripe--inline" role="presentation"></div>

  <section class="draft" aria-labelledby="fa-heading">
    <h2 class="section-title" id="fa-heading">Free agent pickups (no bidding, first come first served)</h2>
    <div class="waiverboard">
      <div class="waiverrow waiverrow--head waiverrow--fa" role="row">
        <span>Team</span>
        <span>Added</span>
        <span>Dropped</span>
      </div>
      {% for m in data.fa_moves %}
      <div class="waiverrow waiverrow--fa" role="row">
        <span>{{ m.team }}</span>
        <span>{{ m.player }}</span>
        <span>{{ m.dropped or '—' }}</span>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% endif %}

</main>

<footer class="foot">
  <p>Updated {{ updated }}. Rebuilt every Wednesday morning after FAAB waivers clear.</p>
  <p class="foot__fine">"Overpay" is the winning bid minus one dollar more than the next-best
  losing bid on the same player (or minus $1 if nobody else bid). ESPN doesn't expose losing
  bids directly, so this is reconstructed from failed competing claims and may miss a bid or
  two in edge cases.</p>
</footer>

</body>
</html>
