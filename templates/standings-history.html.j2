<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }} — Standings history</title>
<meta name="description" content="Final standings by year for {{ site_title }}.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header class="masthead">
  <div class="masthead__inner">
    <p class="masthead__eyebrow">Official rulings &middot; {{ season }} season</p>
    <h1 class="masthead__title">{{ site_title }}</h1>
    <p class="masthead__week">Standings history</p>
  </div>
</header>

<div class="stripe" role="presentation"></div>

<main class="page">

  <nav class="archive" aria-label="Site">
    <h2 class="section-title">Around the league</h2>
    <ul class="archive__list">
      <li><a class="archive__link" href="index.html">Home</a></li>
      <li><a class="archive__link" href="recap.html">Weekly Recap</a></li>
      <li><a class="archive__link" href="keepers.html">Keepers</a></li>
      <li><a class="archive__link" href="draft-history.html">Draft history</a></li>
      <li><a class="archive__link" href="league-basics.html">League basics</a></li>
      <li><a class="archive__link" href="power-rankings.html">Power rankings</a></li>
    </ul>
  </nav>

  <div class="stripe stripe--inline" role="presentation"></div>

  {% if years %}
  <section class="standings" aria-labelledby="standings-heading">
    <h2 class="section-title" id="standings-heading">Final standings, year by year</h2>

    <div class="draft-pills" id="standings-year-pills" role="group" aria-label="Select a year or the all-time average" style="margin-bottom: 1.25rem;">
      <button type="button" class="draft-pill" data-view="average">Average</button>
      {% for y in years %}
      <button type="button" class="draft-pill{% if loop.first %} draft-pill--active{% endif %}" data-view="{{ y }}">{{ y }}</button>
      {% endfor %}
    </div>

    <p class="power__note" id="average-note" style="display:none;">
      Averages each manager's final and regular-season finish across every year
      they've played, then ranks them best to worst. Matched by ESPN account, not
      team name, so a renamed team still gets full credit for its history.
    </p>

    <div class="standingsboard" id="average-board" role="table" aria-label="All-time average finish" style="display:none;">
      <div class="avgrow avgrow--head" role="row">
        <span role="columnheader">Rk</span>
        <span role="columnheader">Team</span>
        <span role="columnheader">Avg final</span>
        <span role="columnheader">Avg reg.</span>
        <span role="columnheader">Yrs</span>
      </div>
      <div id="average-rows"></div>
    </div>

    <p class="foot__fine" id="average-disclaimer" style="margin-top: 1rem; color: var(--whistle); display:none;">
      Shown under each manager's current team name, even for years played under a
      different name.
    </p>

    <div class="standingsboard" id="standings-board" role="table" aria-label="Final standings">
      <div class="standingsrow standingsrow--head" role="row">
        <span role="columnheader">Rk</span>
        <span role="columnheader">Reg</span>
        <span role="columnheader">Team</span>
        <span role="columnheader">Record</span>
        <span role="columnheader">PF</span>
        <span role="columnheader">PA</span>
      </div>
      <div id="standings-rows"></div>
    </div>
  </section>

  <script type="application/json" id="standings-data">{{ years_json|safe }}</script>
  <script type="application/json" id="current-teams-data">{{ current_teams_json|safe }}</script>
  <script>
  (function () {
    var data = JSON.parse(document.getElementById('standings-data').textContent);
    var currentTeams = JSON.parse(document.getElementById('current-teams-data').textContent);

    var pillsEl = document.getElementById('standings-year-pills');
    var years = Object.keys(data).sort().reverse();
    var activeView = years[0];

    var standingsBoard = document.getElementById('standings-board');
    var averageBoard = document.getElementById('average-board');
    var averageNote = document.getElementById('average-note');
    var averageDisclaimer = document.getElementById('average-disclaimer');
    var rowsEl = document.getElementById('standings-rows');
    var avgRowsEl = document.getElementById('average-rows');

    function renderYear(year) {
      var rows = data[year] || [];
      rowsEl.innerHTML = rows.map(function (r) {
        var record = r.wins + '-' + r.losses + (r.ties ? '-' + r.ties : '');
        return '<div class="standingsrow" role="row">' +
          '<span role="cell">' + (r.rank != null ? r.rank : '') + '</span>' +
          '<span role="cell">' + (r.regular_finish != null ? r.regular_finish : '') + '</span>' +
          '<span role="cell">' + (r.team || '') + '</span>' +
          '<span role="cell">' + record + '</span>' +
          '<span role="cell">' + r.points_for.toFixed(1) + '</span>' +
          '<span role="cell">' + r.points_against.toFixed(1) + '</span>' +
          '</div>';
      }).join('');
    }

    // ---- all-time average finish ----
    // Grouped by owner (a stable ESPN account), not team name, so a team
    // that changed its name still gets full credit for every year its
    // owner played, rather than looking like a 1-year-old team.
    var currentNameByOwner = {};
    currentTeams.forEach(function (t) { currentNameByOwner[t.owner_id] = t.team; });

    var acc = {};
    years.forEach(function (year) {
      (data[year] || []).forEach(function (r) {
        if (!r.owner_id || !currentNameByOwner[r.owner_id]) return;
        var a = acc[r.owner_id] || (acc[r.owner_id] = { sumFinal: 0, sumReg: 0, count: 0 });
        if (r.rank != null) a.sumFinal += r.rank;
        if (r.regular_finish != null) a.sumReg += r.regular_finish;
        a.count += 1;
      });
    });

    var averages = Object.keys(acc).map(function (ownerId) {
      var a = acc[ownerId];
      return {
        team: currentNameByOwner[ownerId],
        avgFinal: a.sumFinal / a.count,
        avgReg: a.sumReg / a.count,
        years: a.count,
      };
    });
    averages.sort(function (x, y) { return x.avgFinal - y.avgFinal; });

    avgRowsEl.innerHTML = averages.map(function (r, i) {
      return '<div class="avgrow" role="row">' +
        '<span role="cell">' + (i + 1) + '</span>' +
        '<span role="cell">' + r.team + '</span>' +
        '<span role="cell">' + r.avgFinal.toFixed(1) + '</span>' +
        '<span role="cell">' + r.avgReg.toFixed(1) + '</span>' +
        '<span role="cell">' + r.years + '</span>' +
        '</div>';
    }).join('');

    function render() {
      var showAverage = activeView === 'average';
      averageBoard.style.display = showAverage ? '' : 'none';
      averageNote.style.display = showAverage ? '' : 'none';
      averageDisclaimer.style.display = showAverage ? '' : 'none';
      standingsBoard.style.display = showAverage ? 'none' : '';
      if (!showAverage) renderYear(activeView);
    }

    pillsEl.addEventListener('click', function (e) {
      var btn = e.target.closest('.draft-pill');
      if (!btn) return;
      pillsEl.querySelectorAll('.draft-pill').forEach(function (b) {
        b.classList.remove('draft-pill--active');
      });
      btn.classList.add('draft-pill--active');
      activeView = btn.dataset.view;
      render();
    });

    render();
  })();
  </script>
  {% else %}
  <section class="standings">
    <p class="power__note">No standings fetched yet.</p>
  </section>
  {% endif %}

</main>

<footer class="foot">
  <p>Updated {{ updated }}.</p>
</footer>

</body>
</html>
