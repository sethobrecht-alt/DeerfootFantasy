<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }} — Power rankings</title>
<meta name="description" content="Season-to-date power rankings for {{ site_title }}.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header class="masthead">
  <div class="masthead__inner">
    <p class="masthead__eyebrow">Official rulings &middot; {{ season }} season</p>
    <h1 class="masthead__title">{{ site_title }}</h1>
    <p class="masthead__week">Power rankings</p>
  </div>
</header>

<div class="stripe" role="presentation"></div>

<main class="page">

  <nav class="archive" aria-label="Site">
    <h2 class="section-title">Around the league</h2>
    <ul class="archive__list">
      <li><a class="archive__link" href="index.html">Home</a></li>
      <li><a class="archive__link" href="recap.html">Weekly Recap</a></li>
      <li><a class="archive__link" href="keepers.html">Keepers</a></li>
      <li><a class="archive__link" href="draft-history.html">Draft history</a></li>
      <li><a class="archive__link" href="standings-history.html">Standings history</a></li>
      <li><a class="archive__link" href="league-basics.html">League basics</a></li>
    </ul>
  </nav>

  <div class="stripe stripe--inline" role="presentation"></div>

  {% if rankings %}
  <section class="power" aria-labelledby="power-heading">
    <h2 class="section-title" id="power-heading">Power rankings</h2>
    <p class="power__note">
      Season-to-date, recomputed every week. Blends points for
      ({{ (weights.points * 100)|round|int }}%), record
      ({{ (weights.record * 100)|round|int }}%), and roster health
      ({{ (weights.health * 100)|round|int }}%) &mdash; a team loses health for
      each player currently OUT, on IR, or Doubtful, weighted by that
      player's season scoring average. Win/loss streak is shown but not
      scored; it's noise more often than signal.
    </p>

    <ol class="board">
      {% for t in rankings %}
      <li class="board__row board__row--no-movement{% if t.name == favourite %} board__row--house{% endif %}">
        <span class="board__rank">{{ t.rank }}</span>
        <span class="board__team">
          {{ t.name }}
          <span class="board__record">
            {{ t.record }} &middot; {{ '%.1f'|format(t.points_for) }} PF
            {% if t.streak_length %}
            &middot; <span class="streak-badge{% if t.streak_type == 'WIN' %} streak-badge--win{% else %} streak-badge--loss{% endif %}">{{ 'W' if t.streak_type == 'WIN' else 'L' }}{{ t.streak_length }}</span>
            {% endif %}
          </span>
          {% if t.injuries %}
          <span class="board__injuries">
            {% for inj in t.injuries[:3] %}{% if not loop.first %}, {% endif %}{{ inj.name }} ({{ inj.status|replace('_', ' ')|title }}){% endfor %}{% if t.injuries|length > 3 %}, +{{ t.injuries|length - 3 }} more{% endif %}
          </span>
          {% else %}
          <span class="board__injuries board__injuries--clean">Fully healthy</span>
          {% endif %}
        </span>
        <span class="board__rating">
          <span class="board__bar" style="--fill: {{ t.rating }}%"></span>
          <span class="board__value">{{ '%.1f'|format(t.rating) }}</span>
        </span>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% else %}
  <section class="power">
    <p class="power__note">No power rankings yet &mdash; check back once the season's underway.</p>
  </section>
  {% endif %}

</main>

<footer class="foot">
  <p>Updated {{ updated }}.</p>
</footer>

</body>
</html>
